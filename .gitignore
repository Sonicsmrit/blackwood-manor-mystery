# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Python bytecode.
__pycache__/
*.pyc

# API keys. Copy secrets.example.json to secrets.json and fill it in locally --
# the filled-in copy must never be committed.
**/secrets.json

# Asset archives and local tooling that live beside the project, not in it.
/*.zip
/.freebuff/
/.vscode/
# Duplicate of game/11_shader_chromatic-aberration.rpy, which is the copy Ren'Py
# actually loads. Kept here only as a reference of where the shader came from.
/11_shader_chromatic-aberration.rpy
